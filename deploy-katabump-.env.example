# ============================================================================
# MASTER YOUSEF WOLF EMPIRE — تنظیمات پنل (Katabump)
# ============================================================================
# این فایل رو ویرایش کن و مقادیر داخل کوتیشن ("...") رو با اطلاعات خودت پر کن.
# بعد فایل رو با اسم ".env" روی Katabump آپلود کن یا متغیرها رو در داشبورد
# Katabump → Environment Variables وارد کن.
# ============================================================================

# --- پورت ---
# روی Katabump خالی بذار (خودش ست می‌کنه). روی VPS: 8787
PORT=8787
HOST=0.0.0.0

# --- آدرس عمومی پنل (مهم!) ---
# دامنه‌ای که Katabump بهت میده، بدون https://
# مثال: wolf-empire.kdns.fr
PANEL_HOST="YOUR-KATABUMP-DOMAIN.kdns.fr"
PUBLIC_TLS=1
PUBLIC_LINK_PORT=443

# --- رمز ورود ادمین ---
# یه رمز قوی انتخاب کن
ADMIN_PASSWORD="Wolf2026Empire!"

# --- UUID پنل ---
# یه UUID جدید بساز: https://www.uuidgenerator.net
UUID="06472f28-8568-4e61-9bd1-8ed64f25acc1"

# --- ذخیره‌سازی KV (مهم روی Katabump) ---
# روی Katabump از /data استفاده کن (volume دائمی)
KV_DIR="/data"

# --- ربات تلگرام (اختیاری) ---
# توکن از @BotFather بگیر
TG_BOT_TOKEN=""
# آیدی عددی خودت از @userinfobot بگیر
TG_ADMIN_ID=""

# --- WOLF AI (اختیاری) ---
# کلید Gemini از https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# --- برندینگ ---
BRAND_NAME="MASTER YOUSEF"
BRAND_FULL="MASTER YOUSEF WOLF EMPIRE"
SUPPORT_URL="@Kmnbvczx0090"
TELEGRAM_CHANNEL="https://t.me/vpnstan1"

# --- تنظیمات پیش‌فرض کاربر جدید ---
USER_TRAFFIC_GB=0
USER_EXPIRY_DAYS=30
