# ============================================================================
# MASTER YOUSEF WOLF EMPIRE — Production Environment Example
# ============================================================================
# Copy to: .env (in project root)
# Fill in your values, then NEVER commit this file to git!
# ============================================================================

# === Server ===
PORT=8787
HOST=0.0.0.0
NODE_ENV=production

# === Public URL ===
# Your panel's public domain (without https://)
PANEL_HOST=panel.yourdomain.com
# Set to 1 if behind TLS (https://)
PUBLIC_TLS=1
# Public port for links (443 for HTTPS)
PUBLIC_LINK_PORT=443

# === Admin ===
# Generate a strong password: openssl rand -base64 32
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Generate UUID: node -e "console.log(crypto.randomUUID())"
UUID=06472f28-8568-4e61-9bd1-8ed64f25acc1

# === Storage ===
# KV data directory
KV_DIR=/var/lib/wolf-empire

# === Telegram Bot (optional) ===
# Get token from @BotFather
TG_BOT_TOKEN=
# Get your numeric ID from @userinfobot
TG_ADMIN_ID=

# === WOLF AI (optional) ===
# Get API key from https://z.ai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# === Branding ===
BRAND_NAME=MASTER YOUSEF
BRAND_FULL=MASTER YOUSEF WOLF EMPIRE
SUPPORT_URL=@Kmnbvczx0090
TELEGRAM_CHANNEL=https://t.me/vpnstan1

# === User Defaults ===
# Traffic limit per user in GB (0 = unlimited)
USER_TRAFFIC_GB=0
# Expiry in days (0 = unlimited)
USER_EXPIRY_DAYS=30

# === Advanced (optional) ===
# Logging level (debug, info, warn, error)
LOG_LEVEL=info
# Enable request logging
LOG_REQUESTS=false
